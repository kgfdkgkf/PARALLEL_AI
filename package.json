{
  "name": "parallel-universe-app",
  "version": "1.1.2",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "node tools/web.cjs mobile",
    "mobile": "node tools/web.cjs mobile",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "node tools/web.cjs start",
    "build:web": "node tools/web.cjs build",
    "preview:web": "node tools/preview-web.cjs",
    "mock:ai": "python tools/mock_api.py",
    "typecheck": "node tools/ensure-env.js && tsc --noEmit",
    "test": "node --test tools/engine.test.cjs",
    "test:web": "node tools/web-smoke.cjs",
    "check:env": "node tools/ensure-env.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.24",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-speech": "~58.0.4",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "~6.0.3"
  }
}
