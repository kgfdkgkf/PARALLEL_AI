{
  "expo": {
    "name": "ПАРАЛЛЕЛЬ",
    "slug": "parallel-universe",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#05050C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.parallel.universe",
      "buildNumber": "1"
    },
    "android": {
      "package": "ru.parallel.universe",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#05050C"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png",
      "backgroundColor": "#05050C"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar"
    ]
  }
}
