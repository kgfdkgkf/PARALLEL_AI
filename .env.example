# Необязательный адрес FastAPI для текста и картинок. Его также можно ввести в профиле.
EXPO_PUBLIC_API_URL=

# Подмена Chat Completions для Ollama или тестового провайдера.
EXPO_PUBLIC_AI_BASE_URL=

# Необязательный выбор модели и провайдера по умолчанию.
EXPO_PUBLIC_AI_PROVIDER=
EXPO_PUBLIC_AI_MODEL=

# Только для локальной сборки. Expo включает значение в клиентский пакет.
EXPO_PUBLIC_GROQ_KEY=
