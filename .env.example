# Адрес собственного AI-backend (папка backend/), доступный с телефона в той же сети.
# Не обязателен: бесплатный ключ можно вставить прямо в приложении (Профиль → AI-ядро).
# Пример: http://192.168.1.10:8000
EXPO_PUBLIC_API_URL=

# Подменить адрес Chat Completions у выбранного провайдера (локальный Ollama, vLLM, прокси).
# Пример: http://127.0.0.1:11434/v1/chat/completions
EXPO_PUBLIC_AI_BASE_URL=

# Отключить AI-обложки (по умолчанию включены): EXPO_PUBLIC_ART=0
EXPO_PUBLIC_ART=
