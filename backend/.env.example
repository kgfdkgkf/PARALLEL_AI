# Укажи URL, совместимый с OpenAI Chat Completions API.
# Ключ хранится ТОЛЬКО на сервере — никогда не добавляй его в EXPO_PUBLIC_ переменные.
LLM_CHAT_COMPLETIONS_URL=
LLM_API_KEY=
LLM_MODEL=

# Необязательные настройки
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.9

# Мобильное приложение обращается к backend по адресу из EXPO_PUBLIC_API_URL.
APP_ORIGINS=*
